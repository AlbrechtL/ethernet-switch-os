#!/bin/sh
# Smoke test of the Zyxel GS1900-8 image in rtl838x-qemu, for CI and for a
# quick check after a build. Runs inside the kas container, as
# scripts/mips-rtl838x-qemu does:
#
#   ./kas-container --runtime-args "--network=host" \
#       shell kas/board/zyxel-gs1900-8-a1.yml:kas/opt/rtl838x-qemu.yml -c /work/scripts/mips-rtl838x-qemu-test
#
# 1. Boots the built firmware from the emulated flash and waits until
#    RESTCONF lists the front ports lan1..lan8.
# 2. Uploads the built upgrade .swu to SWUpdate, which rewrites the firmware
#    partition and reboots.
# 3. Waits until the switch has booted again from flash and RESTCONF answers.
#
# Uses switch 9 (ports 2312, 8090, 8170, 1251), so it does not disturb
# switches started with scripts/mips-rtl838x-qemu. Exits non-zero on the first
# failure; the serial console is in build/qemu/rtl838x-switch9.log.

set -eu

here=$(cd "$(dirname "$0")" && pwd)
BUILDDIR=${BUILDDIR:-$here/../build}
MACHINE=zyxel-gs1900-8-a1
SWU=$BUILDDIR/tmp/deploy/images/$MACHINE/ethernet-switch-os-swu-upgrade-$MACHINE.swu
LOG=$BUILDDIR/qemu/rtl838x-switch9.log
HTTP=http://127.0.0.1:8090
SWUPDATE=http://127.0.0.1:8170

mkdir -p "$BUILDDIR/qemu"
rm -f "$LOG"

SWITCH=9 LOG="$LOG" "$here/mips-rtl838x-qemu" &
qemu=$!
trap 'kill $qemu 2>/dev/null || true' EXIT INT TERM

fail() {
    echo "FAIL: $*" >&2
    echo "--- serial console (last 60 lines) ---" >&2
    tail -n 60 "$LOG" >&2 || true
    exit 1
}

# Waits up to $1 seconds for $2 to appear in the serial console.
wait_log() {
    t=0
    while ! grep -q "$2" "$LOG" 2>/dev/null; do
        kill -0 $qemu 2>/dev/null || fail "QEMU exited while waiting for '$2'"
        [ $t -lt "$1" ] || fail "no '$2' after $1 s"
        sleep 2
        t=$((t + 2))
    done
}

# Waits up to $1 seconds until the serial console shows $2 boots.
wait_boots() {
    t=0
    while [ "$(grep -c 'Kernel command line' "$LOG" 2>/dev/null)" -lt "$2" ]; do
        kill -0 $qemu 2>/dev/null || fail "QEMU exited while waiting for boot $2"
        [ $t -lt "$1" ] || fail "no boot $2 after $1 s"
        sleep 2
        t=$((t + 2))
    done
}

# Waits up to $1 seconds until RESTCONF lists lan1..lan8.
wait_restconf() {
    t=0
    while :; do
        ports=$(curl -sf -H 'Accept: application/yang-data+json' \
            "$HTTP/restconf/data/openconfig-interfaces:interfaces" 2>/dev/null |
            grep -o '"lan[1-8]"' | sort -u | wc -l) || ports=0
        [ "$ports" -ge 8 ] && return 0
        kill -0 $qemu 2>/dev/null || fail "QEMU exited while waiting for RESTCONF"
        [ $t -lt "$1" ] || fail "RESTCONF does not list lan1..lan8 after $1 s"
        sleep 5
        t=$((t + 5))
    done
}

echo "== boot from flash"
wait_log 300 'login:'
wait_restconf 300
echo "ok: switch up, lan1..lan8 in RESTCONF"

echo "== update"
[ -e "$SWU" ] || fail "$SWU missing"
curl -sf -F "file=@$SWU" "$SWUPDATE/upload" >/dev/null || fail "upload of $SWU failed"
wait_log 600 'SWUPDATE successful'
wait_boots 120 2
wait_restconf 300
echo "ok: updated firmware booted from flash, lan1..lan8 in RESTCONF"

echo "PASS"
