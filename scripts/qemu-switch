#!/bin/sh
# Boots the emulated QEMU switch (kas/board/qemux86-64-switch.yml) from the
# build directory. Meant to run inside the kas container, which has the
# bitbake-built QEMU and OVMF at hand:
#
#   ./kas-container --kvm --runtime-args "--network=host" \
#       shell kas/board/qemux86-64-switch.yml -c /work/scripts/qemu-switch
#
# --network=host puts the forwarded ports below on the host's 127.0.0.1 and
# lets switches started from different containers reach each other. The
# serial console is the terminal; Ctrl-a x quits QEMU.
#
# Every switch boots its own copy of the disk image, build/qemu/switch<N>.wic,
# which keeps the A/B slots, the boot environments and the saved
# configuration from run to run -- a new build reaches it through a firmware
# update, the way it reaches a real switch. RESET=1 starts over from the
# freshly built image.
#
# Environment:
#   SWITCH=N     which switch, 0..9 (default 0). Picks the disk copy, the
#                MAC addresses and the ports below.
#   CABLES=...   space separated cables between front ports lan2..lan8 of
#                switches started with this script, e.g. "0:2-1:2 0:3-1:3"
#                connects lan2 and lan3 of switch 0 to lan2 and lan3 of
#                switch 1. Every switch of the setup needs the same CABLES.
#   ADDRESS=IP   the switch address the forwarded ports below go to.
#                Default: the factory address 192.168.1.1, or 192.168.1.N+1
#                for a switch that is cabled to another one (see below).
#   RESET=1      replace the disk copy with the built image.
#   LOG=FILE     serial console into FILE instead of the terminal, no
#                interaction (for scripts and CI).
#
# Front ports:
#   lan1         QEMU user networking (slirp) as the management network:
#                192.168.1.0/24 with the host (gateway) at .254-N and a DNS
#                server at .244-N, ADDRESS forwarded to 127.0.0.1 on the
#                host:
#                  ssh      2222 + 10*N
#                  http     8000 + 10*N   (status page, RESTCONF)
#                  SWUpdate 8080 + 10*N
#                The slirp DHCP server hands out 192.168.1.100+10*N and up.
#   lan2..lan8   UDP sockets on 127.0.0.1, port 20000 + 100*N + port number;
#                one front port of another switch at the other end, or
#                nothing (link up, frames go nowhere).
#
# Cabled switches share VLAN 1, lan1 and its user network included, so they
# cannot all keep the factory address: the forwarded ports would reach
# whichever switch answers the ARP first. A cabled switch N therefore
# forwards to 192.168.1.N+1, which it has to be given once, on its serial
# console (see docs/getting-started/qemu-x86-64.md); its disk keeps it.
# For the same reason every switch's user network has addresses of its own:
# slirp derives its MAC addresses from them, and two slirps answering for the
# same address on one VLAN would take each other's traffic.

set -eu

SWITCH=${SWITCH:-0}
CABLES=${CABLES:-}
RESET=${RESET:-}
LOG=${LOG:-}

case "$SWITCH" in
    [0-9]) ;;
    *) echo "SWITCH must be 0..9" >&2; exit 1 ;;
esac

BUILDDIR=${BUILDDIR:-$(cd "$(dirname "$0")/.." && pwd)/build}
MACHINE=qemux86-64-switch
DEPLOY=$BUILDDIR/tmp/deploy/images/$MACHINE
IMAGE=$DEPLOY/qemu-switch-image-$MACHINE.rootfs.wic
STATE=$BUILDDIR/qemu

QEMU=$(ls "$BUILDDIR"/tmp/work/x86_64-linux/qemu-helper-native/*/recipe-sysroot-native/usr/bin/qemu-system-x86_64 2>/dev/null | head -n 1)
if [ -z "$QEMU" ]; then
    echo "no qemu-system-x86_64 in $BUILDDIR -- build kas/board/$MACHINE.yml first" >&2
    exit 1
fi

for f in "$IMAGE" "$DEPLOY/ovmf.code.qcow2" "$DEPLOY/ovmf.vars.qcow2"; do
    if [ ! -e "$f" ]; then
        echo "$f is missing -- build kas/board/$MACHINE.yml first" >&2
        exit 1
    fi
done

mkdir -p "$STATE"
disk=$STATE/switch$SWITCH.wic
vars=$STATE/switch$SWITCH-ovmf-vars.qcow2
if [ -n "$RESET" ] || [ ! -e "$disk" ]; then
    echo "switch $SWITCH: new disk from $(readlink -f "$IMAGE")"
    cp --sparse=always -L "$IMAGE" "$disk"
    cp -L "$DEPLOY/ovmf.vars.qcow2" "$vars"
fi
[ -e "$vars" ] || cp -L "$DEPLOY/ovmf.vars.qcow2" "$vars"

# UDP port of front port $2 (2..8) of switch $1.
port() {
    echo $((20000 + 100 * $1 + $2))
}

# The UDP port the other end of front port $1 of this switch listens on, from
# CABLES. Unconnected ports send to a port nobody listens on.
peer() {
    for cable in $CABLES; do
        a=${cable%-*}
        b=${cable#*-}
        if [ "$a" = "$SWITCH:$1" ]; then
            port "${b%:*}" "${b#*:}"
            return
        fi
        if [ "$b" = "$SWITCH:$1" ]; then
            port "${a%:*}" "${a#*:}"
            return
        fi
    done
    echo $((30000 + 100 * SWITCH + $1))
}

cabled=
for cable in $CABLES; do
    case "$cable" in
        "$SWITCH":*|*-"$SWITCH":*) cabled=1 ;;
    esac
done
if [ -n "$cabled" ]; then
    ADDRESS=${ADDRESS:-192.168.1.$((SWITCH + 1))}
else
    ADDRESS=${ADDRESS:-192.168.1.1}
fi

ssh_port=$((2222 + 10 * SWITCH))
http_port=$((8000 + 10 * SWITCH))
swupdate_port=$((8080 + 10 * SWITCH))

# Front port N sits in PCI slot 0x10+N-1; qemu-switch-ports
# (meta-qemu-switch-bsp) names the virtio-net devices lan1..lan8 in PCI order.
set -- \
    -netdev "user,id=lan1,net=192.168.1.0/24,host=192.168.1.$((254 - SWITCH)),dns=192.168.1.$((244 - SWITCH)),dhcpstart=192.168.1.$((100 + 10 * SWITCH)),hostfwd=tcp:127.0.0.1:$ssh_port-$ADDRESS:22,hostfwd=tcp:127.0.0.1:$http_port-$ADDRESS:80,hostfwd=tcp:127.0.0.1:$swupdate_port-$ADDRESS:8080" \
    -device "virtio-net-pci,netdev=lan1,mac=52:54:00:00:0$SWITCH:01,addr=0x10"
for n in 2 3 4 5 6 7 8; do
    set -- "$@" \
        -netdev "dgram,id=lan$n,local.type=inet,local.host=127.0.0.1,local.port=$(port "$SWITCH" $n),remote.type=inet,remote.host=127.0.0.1,remote.port=$(peer $n)" \
        -device "virtio-net-pci,netdev=lan$n,mac=52:54:00:00:0$SWITCH:0$n,addr=0x$((10 + n - 1))"
done

if [ -r /dev/kvm ] && [ -w /dev/kvm ]; then
    set -- "$@" -enable-kvm -cpu host
else
    echo "switch $SWITCH: no /dev/kvm, emulating the CPU (slow)"
    # Has everything the x86-64-v3 tune of qemux86-64 builds for.
    set -- "$@" -cpu Skylake-Client
fi

if [ -n "$LOG" ]; then
    set -- "$@" -display none -monitor none -serial "file:$LOG"
else
    set -- "$@" -nographic
fi

echo "switch $SWITCH: $ADDRESS forwarded: ssh -p $ssh_port cli@127.0.0.1, http://127.0.0.1:$http_port/, SWUpdate http://127.0.0.1:$swupdate_port/"

# EFI Boot Guard arms the i6300esb watchdog; a reset it causes stays a reset
# (the default), which is what makes a hanging update roll back.
exec "$QEMU" \
    -name "qemu-switch$SWITCH" \
    -machine q35,i8042=off \
    -smp 2 -m 512 \
    -drive "if=pflash,format=qcow2,unit=0,readonly=on,file=$DEPLOY/ovmf.code.qcow2" \
    -drive "if=pflash,format=qcow2,unit=1,file=$vars" \
    -drive "if=none,id=disk,format=raw,file=$disk" \
    -device virtio-blk-pci,drive=disk \
    -device virtio-rng-pci \
    -device i6300esb \
    -action watchdog=reset \
    "$@"
