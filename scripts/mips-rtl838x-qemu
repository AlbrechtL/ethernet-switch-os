#!/bin/sh
# Boots the Zyxel GS1900-8 image in rtl838x-qemu, the emulated RTL8380 switch,
# from the build directory. Meant to run inside the kas container, which has
# the bitbake-built emulator at hand:
#
#   ./kas-container build kas/board/zyxel-gs1900-8-a1.yml:kas/opt/rtl838x-qemu.yml
#   ./kas-container --runtime-args "--network=host" \
#       shell kas/board/zyxel-gs1900-8-a1.yml:kas/opt/rtl838x-qemu.yml -c /work/scripts/mips-rtl838x-qemu
#
# --network=host puts the forwarded ports below on the host's 127.0.0.1 and
# lets switches started from different containers reach each other. The
# serial console is the terminal; Ctrl-a x quits QEMU.
#
# It always boots the firmware the last build left in build/tmp/deploy: it
# lays the firmware partition out in a flash image the way a factory install
# does, and QEMU boots it from there as the switch's bootloader would. QEMU's
# -snapshot keeps every write to the flash, the saved configuration and
# firmware updates included, in a temporary file that goes away with QEMU, so
# every start is the factory state of the latest build. A reboot, after a
# firmware update too, does not restart QEMU and so keeps them.
#
# Environment:
#   SWITCH=N     which switch, 0..9 (default 0). Picks the ports below.
#   CABLES=...   space separated cables between front ports lan2..lan8 of
#                switches started with this script, e.g. "0:2-1:2 0:3-1:3"
#                connects lan2 and lan3 of switch 0 to lan2 and lan3 of
#                switch 1. Every switch of the setup needs the same CABLES.
#   ADDRESS=IP   the switch address the forwarded ports below go to.
#                Default: the factory address 192.168.1.1, or 192.168.1.N+1
#                for a switch that is cabled to another one (see below).
#   LOG=FILE     serial console into FILE instead of the terminal, no
#                interaction (for scripts and CI).
#
# Front ports, the same scheme as scripts/x86-64-q35-qemu:
#   lan1         QEMU user networking (slirp) as the management network:
#                192.168.1.0/24 with the host (gateway) at .254-N and a DNS
#                server at .244-N, ADDRESS forwarded to 127.0.0.1 on the
#                host:
#                  ssh      2222 + 10*N
#                  http     8000 + 10*N   (status page, RESTCONF)
#                  SWUpdate 8080 + 10*N
#                  SNMP     1161 + 10*N   (UDP)
#                The slirp DHCP server hands out 192.168.1.100+10*N and up.
#   lan2..lan8   UDP sockets on 127.0.0.1, port 20000 + 100*N + port number;
#                one front port of another switch at the other end, or
#                nothing (link up, frames go nowhere).
#
# Cabled switches share VLAN 1, lan1 and its user network included, so they
# cannot all keep the factory address: the forwarded ports would reach
# whichever switch answers the ARP first. A cabled switch N therefore
# forwards to 192.168.1.N+1, which it has to be given on its serial console
# after every start (see docs/installation/zyxel-gs1900-8.md), because it
# forgets it on the next. For the same reason every switch's user network has
# addresses of its own: slirp derives its MAC addresses from them, and two
# slirps answering for the same address on one VLAN would take each other's
# traffic.

set -eu

SWITCH=${SWITCH:-0}
CABLES=${CABLES:-}
LOG=${LOG:-}

case "$SWITCH" in
    [0-9]) ;;
    *) echo "SWITCH must be 0..9" >&2; exit 1 ;;
esac

BUILDDIR=${BUILDDIR:-$(cd "$(dirname "$0")/.." && pwd)/build}
MACHINE=zyxel-gs1900-8-a1
KAS_FILES=kas/board/$MACHINE.yml:kas/opt/rtl838x-qemu.yml
DEPLOY=$BUILDDIR/tmp/deploy/images/$MACHINE
FIRMWARE=$DEPLOY/rtl83xx-image-$MACHINE.rootfs.rtl83xx-fw
DATA=$DEPLOY/rtl83xx-image-$MACHINE.rootfs.rtl83xx-data
FLASH=$BUILDDIR/qemu/rtl838x-switch$SWITCH-flash.bin

QEMU=$(ls "$BUILDDIR"/tmp/work/x86_64-linux/rtl838x-qemu-helper-native/*/recipe-sysroot-native/usr/bin/qemu-system-mips-rtl838x 2>/dev/null | head -n 1)
if [ -z "$QEMU" ]; then
    echo "no qemu-system-mips-rtl838x in $BUILDDIR -- build $KAS_FILES first" >&2
    exit 1
fi
for f in "$FIRMWARE" "$DATA"; do
    if [ ! -e "$f" ]; then
        echo "$f is missing -- build $KAS_FILES first" >&2
        exit 1
    fi
done

echo "switch $SWITCH: booting $(readlink -f "$FIRMWARE")"

# The 16 MiB SPI-NOR as a factory install leaves it (partition map in
# meta-rtl83xx-bsp's zyxel-gs1900-8-a1.conf): erased, an empty JFFS2 in
# "data" at 0x60000 and the firmware in "firmware" at 0x260000, where the
# emulator boots from. Written anew on every start, one per switch, so that
# switches running at the same time do not share one.
mkdir -p "$(dirname "$FLASH")"
tr '\000' '\377' < /dev/zero | head -c 16M > "$FLASH"
dd if="$DATA" of="$FLASH" bs=64k seek=$((0x60000 / 0x10000)) conv=notrunc status=none
dd if="$FIRMWARE" of="$FLASH" bs=64k seek=$((0x260000 / 0x10000)) conv=notrunc status=none

# UDP port of front port $2 (2..8) of switch $1.
port() {
    echo $((20000 + 100 * $1 + $2))
}

# The UDP port the other end of front port $1 of this switch listens on, from
# CABLES. Unconnected ports send to a port nobody listens on.
peer() {
    for cable in $CABLES; do
        a=${cable%-*}
        b=${cable#*-}
        if [ "$a" = "$SWITCH:$1" ]; then
            port "${b%:*}" "${b#*:}"
            return
        fi
        if [ "$b" = "$SWITCH:$1" ]; then
            port "${a%:*}" "${a#*:}"
            return
        fi
    done
    echo $((30000 + 100 * SWITCH + $1))
}

cabled=
for cable in $CABLES; do
    case "$cable" in
        "$SWITCH":*|*-"$SWITCH":*) cabled=1 ;;
    esac
done
if [ -n "$cabled" ]; then
    ADDRESS=${ADDRESS:-192.168.1.$((SWITCH + 1))}
else
    ADDRESS=${ADDRESS:-192.168.1.1}
fi

ssh_port=$((2222 + 10 * SWITCH))
http_port=$((8000 + 10 * SWITCH))
swupdate_port=$((8080 + 10 * SWITCH))
snmp_port=$((1161 + 10 * SWITCH))

# The front ports claim the NICs in the order they are given: the first is
# lan1, the second lan2 and so on. -netdev plus "-net nic" rather than -nic,
# which cannot take dgram's dotted options.
set -- \
    -netdev "user,id=lan1,net=192.168.1.0/24,host=192.168.1.$((254 - SWITCH)),dns=192.168.1.$((244 - SWITCH)),dhcpstart=192.168.1.$((100 + 10 * SWITCH)),hostfwd=tcp:127.0.0.1:$ssh_port-$ADDRESS:22,hostfwd=tcp:127.0.0.1:$http_port-$ADDRESS:80,hostfwd=tcp:127.0.0.1:$swupdate_port-$ADDRESS:8080,hostfwd=udp:127.0.0.1:$snmp_port-$ADDRESS:161" \
    -net nic,netdev=lan1
for n in 2 3 4 5 6 7 8; do
    set -- "$@" \
        -netdev "dgram,id=lan$n,local.type=inet,local.host=127.0.0.1,local.port=$(port "$SWITCH" $n),remote.type=inet,remote.host=127.0.0.1,remote.port=$(peer $n)" \
        -net nic,netdev=lan$n
done

if [ -n "$LOG" ]; then
    set -- "$@" -display none -monitor none -serial "file:$LOG"
else
    set -- "$@" -nographic
fi

echo "switch $SWITCH: $ADDRESS forwarded: ssh -p $ssh_port cli@127.0.0.1, http://127.0.0.1:$http_port/, SWUpdate http://127.0.0.1:$swupdate_port/, SNMP udp 127.0.0.1:$snmp_port"

# A reboot resets the machine, which boots the flash again; the watchdog does
# the same when the switch hangs.
exec "$QEMU" \
    -name "rtl838x-switch$SWITCH" \
    -M rtl838x -m 128 \
    -drive "if=mtd,format=raw,file=$FLASH" \
    -snapshot \
    "$@"
